+      transformOrigin={{
+        vertical: "top",
+        horizontal: isMobile ? "right" : "left",
+      }}
+      slotProps={{
+        paper: {
+          sx: {
+            borderRadius: "8px",
+          },
+        },
+      }}
+      onClose={onClose}
+      {...rest}
+    >
+      <MountStoragePolicy onClose={onClose} />
+    </Popover>
+  );
+};
+
+export default MountStoragePolicyPopover;
