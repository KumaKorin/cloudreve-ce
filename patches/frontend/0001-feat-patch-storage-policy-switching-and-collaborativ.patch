+export function mountStoragePolicy(index: number, policy: StoragePolicy): AppThunk {
+  return async (dispatch, getState): Promise<void> => {
+    const uri = getState().fileManager[index].pure_path;
+    if (!uri) {
+      return Promise.reject("No path to create file");
+    }
+
+    let success = true;
+    try {
+      await longRunningTaskWithSnackbar(
+        dispatch(sendMountStoragePolicy({ uri, policy_id: policy.id })),
+        "application:modals.processingRestoring",
+      );
+    } catch (e) {
+      success = false;
+    }
+
+    if (success) {
+      dispatch(refreshFileList(index));
+    }
+
+    if (success) {
+      enqueueSnackbar({
+        message: i18next.t("application:vas.folderPolicySwitched", {
+          name: policy.name,
+        }),
+        variant: "success",
+      });
+    }
+  };
+}
